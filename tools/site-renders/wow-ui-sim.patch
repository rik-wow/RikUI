+/// Internal renderer snapshot; never returns timing through an addon-facing API.
+pub(super) fn render_snapshot(state: &mut LuaState, object: Val) -> LuaResult<(f64, f64)> {
+    let timing = validate(read_timing(state, object)?)?;
+    let span = timing.span();
+    let elapsed = (clock_time(state, object)? - timing.start).clamp(0.0, span);
+    Ok((span, elapsed))
+}
