+
+/// Update timer-bound bars from the same duration clock used by text bindings.
+pub(crate) fn tick_duration_bars(state: &mut LuaState) -> LuaResult<()> {
+    let ids: Vec<u64> = {
+        let sim = borrow_state(state)?;
+        sim.widgets.iter_ids().filter(|id| sim.widgets.get(*id)
+            .is_some_and(|f| f.widget_type == WidgetType::StatusBar)).collect()
+    };
+    for id in ids {
+        let fields = get_or_create_frame_fields(state, id);
+        let duration = table_get_static(state, fields, TIMER_DURATION_FIELD);
+        if matches!(duration, Val::Nil) { continue; }
+        let direction = table_get_static(state, fields, "__statusbar_timer_direction");
+        let (span, elapsed) = crate::lua_api::globals::lua_duration_object::render_snapshot(state, duration)?;
+        let value = if direction == Val::Num(1.0) { span - elapsed } else { elapsed };
+        let mut sim = borrow_state_mut(state)?;
+        if let Some(frame) = sim.widgets.get_mut_visual(id) {
+            frame.statusbar_min = 0.0;
+            frame.statusbar_max = span;
+            frame.statusbar_value = value;
+            frame.statusbar_interpolated_value = value;
+            frame.statusbar_interpolation_target = None;
+        }
+        sim.widgets.mark_rect_dirty(id);
+    }
+    Ok(())
+}
