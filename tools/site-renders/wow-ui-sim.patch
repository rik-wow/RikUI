+// Addon fonts use the same Interface/AddOns paths as Lua SetFont.
+fn load_addon_fonts(db: &mut fontdb::Database, font_map: &mut HashMap<String, FontEntry>) {
+    for root in crate::paths::default_addons_paths() {
+        let mut pending = vec![root.clone()];
+        while let Some(dir) = pending.pop() {
+            let Ok(entries) = std::fs::read_dir(dir) else { continue };
+            for entry in entries.flatten() {
+                let Ok(kind) = entry.file_type() else { continue };
+                let path = entry.path();
+                if kind.is_dir() { pending.push(path); continue; }
+                if !kind.is_file() { continue; }
+                let extension = path.extension().and_then(|v| v.to_str()).unwrap_or("");
+                if !extension.eq_ignore_ascii_case("ttf") && !extension.eq_ignore_ascii_case("otf") { continue; }
+                let Ok(relative) = path.strip_prefix(&root) else { continue };
+                let wow_path = format!("Interface/AddOns/{}", relative.to_string_lossy());
+                let key = normalize_wow_path(&wow_path);
+                if font_map.contains_key(&key) { continue; }
+                let Ok(bytes) = std::fs::read(&path) else { continue };
+                let Some(family) = fontdb_family_name(&bytes) else { continue };
+                db.load_font_data(bytes);
+                register_font_aliases(&[&wow_path], &family, font_map);
+                tracing::debug!("Registered addon font {wow_path} -> {family}");
+            }
+        }
+    }
+}
