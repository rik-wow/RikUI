package-as: RikUI
enable-nolib-creation: no
# No externals: serialization is implemented in src/persistence/codec.lua.
# The hand-written changelog ships in the ZIP and becomes the GitHub release text.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
ignore:
  - .agents
  - .claude
  - .codex
  - .cursor
  - .github
  - .magistr
  - .think-and-ship
  - .workbench
  - .release
  - AGENTS.md
  - CLAUDE.md
  - CONTRIBUTING.md
  - README.md
  - SDD.md
  - workbench.toml
  - RikProbe
  - docs
  - tests
  - tools
  - installer
  - dist
  # Installer-written quest corpus and road data: local only, never packaged.
  - generated/roads
  - generated/corpus
  - media/build_icons.py
  - media/build_textures.py
  - "media/icons/*.svg"
  - presets/community/README.md
  - presets/community/template.lua.example
